[gd_resource type="Resource" script_class="UmbralSpeciesResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/catalog/species_resource.gd" id="1"]

[resource]
script = ExtResource("1")
id = "dew"
initial_form = "dew"
element = "Água"
color = "80d7e5"
powers = ["tidal_splash", "rain_sweep", "dew_mend"]
signature = "moon_tide"
passive_pool = ["fierce", "vital", "swift"]
forms = Array[Dictionary]([
{"id": "dew", "name": "Lonlon", "nature": "water", "secondary_nature": "", "resistances": {"water": 25}, "art": "umbrals/dew", "trait_id": "marked_tide", "trait": "Maré Marcada", "trait_description": "Poderes de água deixam Encharcado por %d rodadas.", "trait_value": 2, "stats": {"max_hp": 42, "attack": 9, "defense": 2, "speed": 20}, "power_profile": {"damage": 0, "block": 0, "heal": 0, "burn": 0, "wet": 0}, "lore": {"title": "Uma esfera ao alcance dos gestos", "text": "Lonlon é uma pequena lontra que controla livremente uma esfera de água. Ela pode se afastar do corpo, acompanhar seus gestos e retornar quando ele a chama.\n\nA água é conduzida pelo próprio Lonlon. A esfera ainda não tem vida independente."}},
{"id": "mareveu", "name": "Lonaro", "nature": "water", "secondary_nature": "", "resistances": {"water": 25}, "art": "umbrals/mareveu", "trait_id": "marked_tide", "trait": "Maré Marcada", "trait_description": "Poderes de água deixam Encharcado por %d rodadas.", "trait_value": 3, "stats": {"max_hp": 54, "attack": 12, "defense": 3, "speed": 22}, "power_profile": {"damage": 5, "block": 4, "heal": 2, "burn": 1, "wet": 1}, "lore": {"title": "A água acompanha seus movimentos", "text": "Lonaro conserva o controle da esfera de água que o acompanha desde Lonlon. A esfera pode se separar do corpo e continuar sob seu comando.\n\nO vínculo com a água faz parte da própria criatura; seus poderes não vêm de quem a acompanha."}},
{"id": "londraval", "name": "Londraval", "catalog_revision": 5, "nature": "water", "secondary_nature": "", "resistances": {"water": 25}, "art": "umbrals/londraval", "trait_id": "marked_tide", "trait": "Maré Marcada", "trait_description": "Poderes de água deixam Encharcado por %d rodadas.", "trait_value": 4, "stats": {"max_hp": 66, "attack": 15, "defense": 4, "speed": 24}, "power_profile": {"damage": 10, "block": 8, "heal": 4, "burn": 2, "wet": 2}, "lore": {"title": "A água sob seu comando", "text": "Londraval mantém o controle da água que o acompanha desde Lonlon. Sua esfera continua sendo água conduzida por seus próprios gestos."}},
{"id": "lonelo", "name": "Lonelo", "catalog_revision": 5, "nature": "water", "secondary_nature": "", "resistances": {"water": 25}, "art": "umbrals/lonelo", "trait_id": "marked_tide", "trait": "Maré Marcada", "trait_description": "Poderes de água deixam Encharcado por %d rodadas.", "trait_value": 4, "stats": {"max_hp": 66, "attack": 15, "defense": 4, "speed": 24}, "power_profile": {"damage": 10, "block": 8, "heal": 4, "burn": 2, "wet": 2}, "lore": {"title": "Uma companheira viva", "text": "A esfera que acompanha Lonelo ganhou vida própria. Ela é uma companheira ligada à lontra e depende dela para existir. O vínculo entre as duas continua sendo parte do mesmo Umbral."}},
])
evolutions = Array[Dictionary]([{"id": "dew_to_mareveu", "from": "dew", "to": "mareveu"}, {"id": "mareveu_to_londraval", "from": "mareveu", "to": "londraval", "catalog_revision": 5}, {"id": "mareveu_to_lonelo", "from": "mareveu", "to": "lonelo", "catalog_revision": 5}])
