{"id": "dew", "name": "Lonlon", "nature": "water", "secondary_nature": "", "resistances": {"water": 25}, "art": "umbrals/dew", "trait_id": "marked_tide", "trait": "Maré Marcada", "trait_description": "Poderes de água deixam Encharcado por %d rodadas.", "trait_value": 2, "stats": {"max_hp": 42, "attack": 9, "defense": 2, "speed": 20}, "power_profile": {"damage": 0, "block": 0, "heal": 0, "burn": 0, "wet": 0}, "lore": {"title": "Uma esfera ao alcance dos gestos", "text": "Lonlon é uma pequena lontra que controla livremente uma esfera de água. Ela pode se afastar do corpo, acompanhar seus gestos e retornar quando ele a chama.\n\nA água é conduzida pelo próprio Lonlon. A esfera ainda não tem vida independente."}},
{"id": "mareveu", "name": "Lonaro", "nature": "water", "secondary_nature": "", "resistances": {"water": 25}, "art": "umbrals/mareveu", "trait_id": "marked_tide", "trait": "Maré Marcada", "trait_description": "Poderes de água deixam Encharcado por %d rodadas.", "trait_value": 3, "stats": {"max_hp": 54, "attack": 12, "defense": 3, "speed": 22}, "power_profile": {"damage": 5, "block": 4, "heal": 2, "burn": 1, "wet": 1}, "lore": {"title": "A água acompanha seus movimentos", "text": "Lonaro conserva o controle da esfera de água que o acompanha desde Lonlon. A esfera pode se separar do corpo e continuar sob seu comando.\n\nO vínculo com a água faz parte da própria criatura; seus poderes não vêm de quem a acompanha."}},
])
