[gd_resource type="Resource" script_class="UmbralSpeciesResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/catalog/species_resource.gd" id="1"]

[resource]
script = ExtResource("1")
id = "volt"
initial_form = "volt"
element = "Raio"
color = "e8cf81"
powers = ["lightning", "interference", "storm_dive"]
signature = "judgment"
passive_pool = ["fierce", "ardent", "swift"]
forms = Array[Dictionary]([
{"id": "volt", "name": "Faísca", "nature": "lightning", "secondary_nature": "", "resistances": {"lightning": 25}, "art": "umbrals/volt", "trait_id": "living_circuit", "trait": "Circuito Vivo", "trait_description": "Ataques: +%d dano por outro aliado ativo.", "trait_value": 4, "stats": {"max_hp": 36, "attack": 11, "defense": 1, "speed": 18}, "power_profile": {"damage": 0, "block": 0, "heal": 0, "burn": 0, "wet": 0}, "lore": {"title": "Quem não consegue guardar uma tempestade", "text": "Faísca carrega a lembrança de um sino atingido por um raio. Impaciente, testa galhos com as antenas e às vezes se assusta com a própria descarga.\n\nA eletricidade encontra caminhos mais firmes quando ele está perto de outros Umbrals. Sozinho, continua procurando um eco que responda."}},
{"id": "tempestral", "name": "Tempestral", "nature": "lightning", "secondary_nature": "water", "resistances": {"lightning": 25}, "art": "umbrals/tempestral", "trait_id": "living_circuit", "trait": "Circuito Vivo", "trait_description": "Ataques: +%d dano por outro aliado ativo.", "trait_value": 7, "stats": {"max_hp": 48, "attack": 14, "defense": 2, "speed": 20}, "power_profile": {"damage": 5, "block": 4, "heal": 2, "burn": 1, "wet": 1}, "lore": {"title": "O eco encontrou um caminho", "text": "As descargas inquietas de Faísca se organizam nos circuitos da carapaça de Tempestral. Suas antenas percorrem o ar como quem escuta uma tempestade distante.\n\nMesmo em repouso, mantém um brilho baixo para que seus companheiros saibam onde encontrá-lo."}},
])
evolutions = Array[Dictionary]([{"id": "volt_to_tempestral", "from": "volt", "to": "tempestral"}])
