[gd_resource type="Resource" script_class="UmbralSpeciesResource" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/catalog/species_resource.gd" id="1"]

[resource]
script = ExtResource("1")
id = "volt"
initial_form = "volt"
element = "Raio"
color = "e8cf81"
powers = ["lightning", "interference", "storm_dive"]
signature = "judgment"
passive_pool = ["fierce", "ardent", "swift"]
forms = Array[Dictionary]([
{"id": "volt", "name": "Nisca", "nature": "lightning", "secondary_nature": "", "resistances": {"lightning": 25}, "art": "umbrals/volt", "trait_id": "living_circuit", "trait": "Circuito Vivo", "trait_description": "Ataques: +%d dano por outro aliado ativo.", "trait_value": 4, "stats": {"max_hp": 36, "attack": 11, "defense": 1, "speed": 18}, "power_profile": {"damage": 0, "block": 0, "heal": 0, "burn": 0, "wet": 0}, "lore": {"title": "Quem não consegue guardar uma tempestade", "text": "Nisca é inquieto e às vezes se assusta com a própria descarga.\n\nA eletricidade encontra caminhos mais firmes quando ele está perto de outros Umbrals. Sozinho, continua procurando um eco que responda."}},
{"id": "tempestral", "name": "Niscor", "nature": "lightning", "secondary_nature": "water", "resistances": {"lightning": 25}, "art": "umbrals/tempestral", "trait_id": "living_circuit", "trait": "Circuito Vivo", "trait_description": "Ataques: +%d dano por outro aliado ativo.", "trait_value": 7, "stats": {"max_hp": 48, "attack": 14, "defense": 2, "speed": 20}, "power_profile": {"damage": 5, "block": 4, "heal": 2, "burn": 1, "wet": 1}, "lore": {"title": "O eco encontrou um caminho", "text": "As descargas inquietas de Nisca encontram um ritmo mais firme em Niscor. Seus pelos azuis acompanham o movimento do corpo enquanto a carga cresce.\n\nMesmo em repouso, mantém um brilho baixo para que seus companheiros saibam onde encontrá-lo."}},
{"id": "auravel", "name": "Auravel", "nature": "lightning", "secondary_nature": "water", "resistances": {"lightning": 25}, "art": "umbrals/auravel", "trait_id": "living_circuit", "trait": "Circuito Vivo", "trait_description": "Ataques: +%d dano por outro aliado ativo.", "trait_value": 8, "stats": {"max_hp": 56, "attack": 16, "defense": 2, "speed": 25}, "power_profile": {"damage": 8, "block": 6, "heal": 3, "burn": 1, "wet": 1}, "lore": {"title": "Asas sobre a corrente", "text": "Auravel abre asas de membranas douradas sobre o corpo coberto de espinhos. No chão, mantém as quatro patas firmes; ao atacar, ergue as asas e acompanha a descarga com o corpo."}},
{"id": "zuldar", "name": "Zuldar", "nature": "lightning", "secondary_nature": "", "resistances": {"lightning": 25}, "art": "umbrals/zuldar", "trait_id": "living_circuit", "trait": "Circuito Vivo", "trait_description": "Ataques: +%d dano por outro aliado ativo.", "trait_value": 8, "stats": {"max_hp": 64, "attack": 19, "defense": 4, "speed": 17}, "power_profile": {"damage": 10, "block": 8, "heal": 2, "burn": 1, "wet": 1}, "lore": {"title": "A força encontra apoio", "text": "Zuldar sustenta o corpo nas patas traseiras. Seus espinhos azuis acompanham a coluna e permanecem presos ao dorso enquanto ele se prepara para golpear."}},
])
evolutions = Array[Dictionary]([{"id": "volt_to_tempestral", "from": "volt", "to": "tempestral"}, {"id": "tempestral_to_auravel", "from": "tempestral", "to": "auravel", "deferred": true}, {"id": "tempestral_to_zuldar", "from": "tempestral", "to": "zuldar", "deferred": true}])
